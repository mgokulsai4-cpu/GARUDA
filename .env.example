# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# COMMERCIAL TRANSIT PROVIDER APIS (Server-Side Only)
# ==============================================================================
# IRCTC / Indian Railways API (RapidAPI / Railofy / Official Indian Rail API):
# When configured, GARUDA connects to live train schedules, PNR tracking, and seat availability.
IRCTC_API_KEY=""
IRCTC_API_BASE_URL="https://irctc-indian-railway-pnr-status.p.rapidapi.com"

# RedBus / AbhiBus / State RTC Bus API:
# When configured, GARUDA connects to real-time bus seats, live tracking GPS coordinates, and bus routes.
REDBUS_API_KEY=""
REDBUS_API_BASE_URL="https://api.redbus.in/v2"

# AviationStack / Flight Tracking API:
# When configured, GARUDA connects to live flight schedules and terminal departures.
AVIATIONSTACK_API_KEY=""

# ==============================================================================
# COMMERCIAL RENTAL PROVIDER APIS (Server-Side Only)
# ==============================================================================
# Zoomcar Partner API:
# When configured, GARUDA connects to live Zoomcar self-drive fleet inventory, pricing, and reservation holds.
ZOOMCAR_API_KEY=""
ZOOMCAR_API_BASE_URL="https://api.zoomcar.com/v1"

# Royal Brothers Two-Wheeler Rental API:
# When configured, GARUDA connects to live motorcycle & scooter rental availability in 40+ Indian cities.
ROYAL_BROTHERS_API_KEY=""
ROYAL_BROTHERS_API_BASE_URL="https://api.royalbrothers.com/v2"
